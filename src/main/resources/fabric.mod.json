{
  "schemaVersion": 1,
  "id": "pickuprange",
  "version": "${version}",

  "name": "Pickup Range",
  "description": "Configurable item and XP orb pickup range with per-player settings, commands, and an in-game settings screen.",
  "authors": [
    "wenhaoquestion"
  ],
  "contributors": [
    "HadronCollision — original PickupWidely concept"
  ],
  "contact": {
    "discord": "https://discord.com/users/930191705360195665",
    "sources": "https://github.com/wenhaoquestion/PickupWidely-fabric"
  },

  "license": "MIT",
  "icon": "assets/pickuprange/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.pickuprange.PickupRangeMod"
    ],
    "client": [
      "com.example.pickuprange.PickupRangeClientMod"
    ]
  },
  "mixins": [
    "pickuprange.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.17.3",
    "fabric-api": "*",
    "minecraft": "1.21.10",
    "java": ">=21"
